{
  "schemaVersion": 2,
  "mode": "observe",
  "project": {
    "primaryBranch": "main"
  },
  "runtime": {
    "minimumVersion": "0.7.26",
    "protocolVersion": 1,
    "lockFile": "sentinel.lock.json"
  },
  "guard": {
    "directCommands": {
      "npmScripts": [],
      "npxTools": ["tsc"],
      "cargoSubcommands": [],
      "tools": ["tsc"]
    }
  },
  "analyzers": {
    "sentinel": {
      "enabled": true,
      "profile": "project-default",
      "config": {
        "includePatterns": [
          "**/*"
        ],
        "excludePatterns": [
          "**/node_modules/**",
          "**/dist/**",
          "**/out/**",
          "**/.vscode-test/**",
          "**/fixtures/**"
        ],
        "directoryExceptions": [],
        "portableBoundaries": {
          "dom": ["/platform/", "/plataforma/", "/adapters/", "/dom."],
          "window": ["/platform/", "/plataforma/", "/adapters/", "/navigation/"],
          "tooling": ["/esbuild.config.mjs"]
        },
        "rules": {}
      }
    }
  }
}
