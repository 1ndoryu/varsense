{
  "schemaVersion": 2,
  "mode": "observe",
  "project": {
    "primaryBranch": "main"
  },
  "runtime": {
    "minimumVersion": "0.7.26",
    "protocolVersion": 1
  },
  "guard": {
    "directCommands": {
      "npmScripts": [],
      "npxTools": ["tsc"],
      "cargoSubcommands": [],
      "tools": ["tsc"]
    }
  },
  "analyzers": {
    "sentinel": {
      "enabled": true,
      "profile": "project-default"
    }
  },
  "includePatterns": [
    "**/*"
  ],
  "excludePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/out/**",
    "**/.vscode-test/**",
    "**/fixtures/**"
  ],
  "directoryExceptions": [],
  "portableBoundaries": {
    "dom": ["/platform/", "/plataforma/", "/adapters/", "/dom."],
    "window": ["/platform/", "/plataforma/", "/adapters/", "/navigation/"]
  },
  "rules": {}
}
